blueprint:
  name: Inovelli VZM31-SN Bulk Configuration
  description: Comprehensive configuration for multiple Inovelli VZM31-SN switches. Includes LED settings, button behavior, dimming, power reporting, fan control, and advanced features. All parameters from Zigbee2MQTT are supported.
  domain: script
  author: Home Assistant Community
  homeassistant:
    min_version: 2024.1.0
  input:
    # Execution Control Settings
    preview_mode:
      name: Preview Mode (Dry Run)
      description: When enabled, shows what would change without actually applying the configuration
      default: true
      selector:
        boolean:

    show_unchanged:
      name: Show Unchanged Settings
      description: Also display settings that won't change in the preview
      default: false
      selector:
        boolean:

    # LED Color Settings
    led_color_when_on:
      name: LED Color When On
      description: Set the color of the LED Indicator when the load is on
      default: "170"
      selector:
        select:
          options:
            - label: "Red"
              value: "0"
            - label: "Orange"
              value: "21"
            - label: "Yellow"
              value: "42"
            - label: "Green"
              value: "85"
            - label: "Cyan"
              value: "127"
            - label: "Blue"
              value: "170"
            - label: "Violet"
              value: "212"
            - label: "Pink"
              value: "234"
            - label: "White"
              value: "255"

    led_color_when_off:
      name: LED Color When Off
      description: Set the color of the LED Indicator when the load is off
      default: "170"
      selector:
        select:
          options:
            - label: "Red"
              value: "0"
            - label: "Orange"
              value: "21"
            - label: "Yellow"
              value: "42"
            - label: "Green"
              value: "85"
            - label: "Cyan"
              value: "127"
            - label: "Blue"
              value: "170"
            - label: "Violet"
              value: "212"
            - label: "Pink"
              value: "234"
            - label: "White"
              value: "255"

    # LED Intensity Settings
    led_intensity_when_on:
      name: LED Intensity When On
      description: Set the intensity of the LED Indicator when the load is on
      default: 75
      selector:
        number:
          min: 0
          max: 100
          unit_of_measurement: "%"
          mode: slider

    led_intensity_when_off:
      name: LED Intensity When Off
      description: Set the intensity of the LED Indicator when the load is off
      default: 25
      selector:
        number:
          min: 0
          max: 100
          unit_of_measurement: "%"
          mode: slider

    # LED Mode
    on_off_led_mode:
      name: LED Display Mode
      description: When the device is in On/Off mode, use full LED bar or just one LED
      default: "All"
      selector:
        select:
          options:
            - "All"
            - "One"

    # Button Configuration
    button_delay:
      name: Button Press Delay
      description: This will set the button press delay. 0 = no delay (Disables Button Press Events), Default = 500ms
      default: "500ms"
      selector:
        select:
          options:
            - label: "None"
              value: "0ms"
            - label: "100ms"
              value: "100ms"
            - label: "200ms"
              value: "200ms"
            - label: "300ms"
              value: "300ms"
            - label: "400ms"
              value: "400ms"
            - label: "500ms"
              value: "500ms"
            - label: "600ms"
              value: "600ms"
            - label: "700ms"
              value: "700ms"
            - label: "800ms"
              value: "800ms"
            - label: "900ms"
              value: "900ms"

    single_tap_behavior:
      name: Single Tap Behavior
      description: Behavior of single tapping the on or off button. Old behavior turns the switch on or off. New behavior cycles through the levels set by P131-133
      default: "Disabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Old Behavior"
            - "New Behavior"
            - "Down Always Off"

    # Double Tap Configuration
    double_tap_up_enabled:
      name: Enable Double Tap Up
      description: Enable or Disable setting level to parameter 55 on double-tap UP
      default: "Enabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    double_tap_down_enabled:
      name: Enable Double Tap Down
      description: Enable or Disable setting level to parameter 56 on double-tap DOWN
      default: "Enabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    double_tap_up_level:
      name: Double Tap Up Brightness Level
      description: Set this level on double-tap UP (if enabled by P53). 255 = send ON command
      default: 255
      selector:
        number:
          min: 0
          max: 255
          mode: slider

    double_tap_down_level:
      name: Double Tap Down Brightness Level
      description: Set this level on double-tap DOWN (if enabled by P54)
      default: 0
      selector:
        number:
          min: 0
          max: 255
          mode: slider

    double_tap_clear_notifications:
      name: Double Tap Config Button to Clear Notifications
      description: Double-Tap the Config button to clear notifications
      default: "Enabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    # Dimming Speed Settings
    dimming_speed_up_remote:
      name: Remote Dimming Speed Up
      description: Changes the speed that the light dims up when controlled from the hub. Setting of 0 turns light immediately on. Every number represents 100ms
      default: 25
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    dimming_speed_up_local:
      name: Local Dimming Speed Up
      description: Changes the speed that the light dims up when controlled at the switch. Every number represents 100ms
      default: 25
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    dimming_speed_down_remote:
      name: Remote Dimming Speed Down
      description: Changes the speed that the light dims down when controlled from the hub. Every number represents 100ms
      default: 25
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    dimming_speed_down_local:
      name: Local Dimming Speed Down
      description: Changes the speed that the light dims down when controlled at the switch. Every number represents 100ms
      default: 25
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    # Ramp Rate Settings
    ramp_rate_off_to_on_remote:
      name: Remote Ramp Rate Off to On
      description: Changes the speed that the light turns on when controlled from the hub. A setting of 0 turns the light immediately on. Every number represents 100ms
      default: 2
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    ramp_rate_off_to_on_local:
      name: Local Ramp Rate Off to On
      description: Changes the speed that the light turns on when controlled at the switch. A setting of 0 turns the light immediately on. Every number represents 100ms
      default: 2
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    ramp_rate_on_to_off_remote:
      name: Remote Ramp Rate On to Off
      description: Changes the speed that the light turns off when controlled from the hub. A setting of 0 turns the light immediately off. Every number represents 100ms
      default: 2
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    ramp_rate_on_to_off_local:
      name: Local Ramp Rate On to Off
      description: Changes the speed that the light turns off when controlled at the switch. A setting of 0 turns the light immediately off. Every number represents 100ms
      default: 2
      selector:
        number:
          min: 0
          max: 127
          mode: slider

    # Min/Max Level Settings
    minimum_level:
      name: Minimum Brightness Level
      description: The minimum level that the dimmer allows the bulb to be dimmed to. Useful when the user has an LED bulb that does not turn on or flickers at a lower level
      default: 1
      selector:
        number:
          min: 1
          max: 254
          mode: slider

    maximum_level:
      name: Maximum Brightness Level
      description: The maximum level that the dimmer allows the bulb to be dimmed to. Useful when the user has an LED bulb that reaches its maximum level before the dimmer value of 99
      default: 255
      selector:
        number:
          min: 2
          max: 255
          mode: slider

    # Power Settings
    default_level_local:
      name: Default Level (Local)
      description: Default level for the load when it is turned on at the switch. A setting of 255 means that the switch will return to the level that it was on before it was turned off
      default: 0
      selector:
        number:
          min: 0
          max: 255
          mode: slider

    default_level_remote:
      name: Default Level (Remote)
      description: Default level for the load when it is turned on from the hub. A setting of 255 means that the switch will return to the level that it was on before it was turned off
      default: 0
      selector:
        number:
          min: 0
          max: 255
          mode: slider

    # State After Power Restored
    state_after_power_restored:
      name: State After Power Restored
      description: The state the switch should return to when power is restored after power failure. 0 = off, 1-254 = level, 255 = previous
      default: "0"
      selector:
        select:
          options:
            - label: "Off"
              value: "0"
            - label: "On"
              value: "1"
            - label: "Previous State"
              value: "2"

    # Load Type
    load_type:
      name: Load Type
      description: Type of load connected to switch
      default: "Single Pole (0)"
      selector:
        select:
          options:
            - "Single Pole (0)"
            - "3-Way Dumb Switch (1)"
            - "3-Way Aux Switch (2)"

    # Switch Mode
    switch_mode:
      name: Switch Mode
      description: Dimmer or On/Off mode
      default: "Dimmer"
      selector:
        select:
          options:
            - "Dimmer"
            - "On/Off"

    # Smart Bulb Mode
    smart_bulb_mode:
      name: Smart Bulb Mode
      description: For use with Smart Bulbs that need constant power and are controlled via commands rather than power
      default: "Disabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    # Quick Start
    quick_start_time:
      name: Quick Start Time
      description: Duration of full power output while lamp transitions from Off to On. In 60th of second. 0 = disable, 1 = 1/60s, 60 = 1s
      default: 0
      selector:
        number:
          min: 0
          max: 60
          unit_of_measurement: "ms"
          mode: slider

    quick_start_level:
      name: Quick Start Level
      description: Level of power output during Quick Start Light time (P23)
      default: 0
      selector:
        number:
          min: 0
          max: 255
          mode: slider

    # Leading/Trailing Edge
    leading_trailing_edge:
      name: Leading/Trailing Edge
      description: Dimmer type for compatibility
      default: "Leading"
      selector:
        select:
          options:
            - "Leading"
            - "Trailing"

    # Protection Settings
    local_protection:
      name: Local Protection
      description: Ability to control switch from the wall
      default: "Disabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    remote_protection:
      name: Remote Protection
      description: Ability to control switch from the hub
      default: "Disabled"
      selector:
        select:
          options:
            - label: "Disabled"
              value: "Disabled"
            - label: "Enabled"
              value: "Enabled"
            - label: "No Command Disable Local"
              value: "NoCommandDisableLocal"
            - label: "No Command Enable Local"
              value: "NoCommandEnableLocal"

    # Firmware Update Indicator
    firmware_update_indicator:
      name: Firmware Update In Progress Indicator
      description: Display progress on LED bar during firmware update
      default: "Enabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    # Relay Click
    relay_click:
      name: Relay Click Sound
      description: In neutral on/off setups, the default is to have a clicking sound to notify you that the relay is open or closed
      default: "Enabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    # Disable Clear Notifications Startup
    disable_clear_notifications_startup:
      name: Disable Clear Notifications on Startup
      description: Keep LED notifications after power cycle
      default: "Disabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    # Individual LED Configuration (Optional - Advanced)
    configure_individual_leds:
      name: Configure Individual LEDs
      description: Enable individual LED customization (Advanced)
      default: false
      selector:
        boolean:

    # LED 1 Settings
    default_led1_color_when_on:
      name: LED 1 Color When On
      description: Individual LED 1 color when on (255=sync with default)
      default: 255
      selector:
        number:
          min: 0
          max: 255
          mode: slider

    default_led1_color_when_off:
      name: LED 1 Color When Off
      description: Individual LED 1 color when off (255=sync with default)
      default: 255
      selector:
        number:
          min: 0
          max: 255
          mode: slider

    default_led1_intensity_when_on:
      name: LED 1 Intensity When On
      description: Individual LED 1 brightness when on (101=sync with default)
      default: 101
      selector:
        number:
          min: 0
          max: 101
          mode: slider

    default_led1_intensity_when_off:
      name: LED 1 Intensity When Off
      description: Individual LED 1 brightness when off (101=sync with default)
      default: 101
      selector:
        number:
          min: 0
          max: 101
          mode: slider

    # LED Bar Scaling
    led_bar_scaling:
      name: LED Bar Scaling Mode
      description: Method used for scaling
      default: "Gen3 method (VZM-style)"
      selector:
        select:
          options:
            - "Gen3 method (VZM-style)"
            - "Gen2 method (LZW-style)"

    # Output Mode
    output_mode:
      name: Output Mode
      description: Use device as a Dimmer or an On/Off switch
      default: "Dimmer"
      selector:
        select:
          options:
            - "Dimmer"
            - "On/Off"

    # Invert Switch
    invert_switch:
      name: Invert Switch Orientation
      description: Inverts the orientation of the switch. Useful when installed upside down
      default: "No"
      selector:
        select:
          options:
            - "No"
            - "Yes"

    # Auto Timer Off
    auto_timer_off:
      name: Auto Timer Off
      description: Automatically turns the switch off after this many seconds. When the switch is turned on a timer is started. When the timer expires, the switch is turned off. 0 = Auto off is disabled
      default: 0
      selector:
        number:
          min: 0
          max: 32767
          unit_of_measurement: "seconds"
          mode: box

    # Binding Off to On Sync Level
    binding_off_to_on_sync_level:
      name: Binding Off to On Sync Level
      description: Send Move_To_Level using Default Level with Off/On to bound devices
      default: "Disabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    # Aux Switch Unique Scenes
    aux_switch_unique_scenes:
      name: Aux Switch Unique Scenes
      description: Have unique scene numbers for scenes activated with the aux switch
      default: "Disabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Enabled"

    # Power Reporting Settings
    active_power_reports:
      name: Active Power Reports
      description: Percent power level change that will result in a new power report being sent. 0 = Disabled
      default: 10
      selector:
        number:
          min: 0
          max: 100
          unit_of_measurement: "%"
          mode: slider

    periodic_power_energy_reports:
      name: Periodic Power & Energy Reports
      description: Time period between consecutive power & energy reports being sent (in seconds)
      default: 3600
      selector:
        number:
          min: 0
          max: 32767
          unit_of_measurement: "seconds"
          mode: box

    active_energy_reports:
      name: Active Energy Reports
      description: Energy level change which will result in sending a new energy report. 0 = disabled, 1-32767 = 0.01kWh-327.67kWh
      default: 10
      selector:
        number:
          min: 0
          max: 32767
          unit_of_measurement: "0.01 kWh"
          mode: box

    # Fan Control Mode
    fan_control_mode:
      name: Fan Control Mode
      description: Which mode to use when binding EP3 (config button) to another device (like a fan module)
      default: "Disabled"
      selector:
        select:
          options:
            - "Disabled"
            - "Multi Tap"
            - "Cycle"

    low_level_for_fan_control:
      name: Fan Control Low Speed Level
      description: Dimmer level for low fan speed (2-254)
      default: 33
      selector:
        number:
          min: 2
          max: 254
          mode: slider

    med_level_for_fan_control:
      name: Fan Control Medium Speed Level
      description: Dimmer level for medium fan speed (2-254)
      default: 66
      selector:
        number:
          min: 2
          max: 254
          mode: slider

    high_level_for_fan_control:
      name: Fan Control High Speed Level
      description: Dimmer level for high fan speed (2-254)
      default: 99
      selector:
        number:
          min: 2
          max: 254
          mode: slider

    led_color_for_fan_control:
      name: LED Color for Fan Control Mode
      description: LED color when in fan control mode
      default: "127"
      selector:
        select:
          options:
            - label: "Red"
              value: "0"
            - label: "Orange"
              value: "21"
            - label: "Yellow"
              value: "42"
            - label: "Green"
              value: "85"
            - label: "Cyan"
              value: "127"
            - label: "Blue"
              value: "170"
            - label: "Violet"
              value: "212"
            - label: "Pink"
              value: "234"
            - label: "White"
              value: "255"

fields:
  target_devices:
    name: Target Devices
    description: Select the Inovelli VZM31-SN switches to configure
    required: true
    selector:
      entity:
        multiple: true
        filter:
          - integration: mqtt
            domain: light
          - integration: mqtt
            domain: switch

variables:
  # Color value to name mapping
  color_names:
    "0": "Red"
    "21": "Orange"
    "42": "Yellow"
    "85": "Green"
    "127": "Cyan"
    "170": "Blue"
    "212": "Violet"
    "234": "Pink"
    "255": "White"

sequence:
  # Capture all input values at sequence level so they're accessible in templates
  - variables:
      input_led_color_when_on: !input led_color_when_on
      input_led_color_when_off: !input led_color_when_off
      input_led_intensity_when_on: !input led_intensity_when_on
      input_led_intensity_when_off: !input led_intensity_when_off
      input_on_off_led_mode: !input on_off_led_mode
      input_button_delay: !input button_delay
      input_single_tap_behavior: !input single_tap_behavior
      input_double_tap_up_enabled: !input double_tap_up_enabled
      input_double_tap_down_enabled: !input double_tap_down_enabled
      input_double_tap_up_level: !input double_tap_up_level
      input_double_tap_down_level: !input double_tap_down_level
      input_double_tap_clear_notifications: !input double_tap_clear_notifications
      input_dimming_speed_up_remote: !input dimming_speed_up_remote
      input_dimming_speed_up_local: !input dimming_speed_up_local
      input_dimming_speed_down_remote: !input dimming_speed_down_remote
      input_dimming_speed_down_local: !input dimming_speed_down_local
      input_ramp_rate_off_to_on_remote: !input ramp_rate_off_to_on_remote
      input_ramp_rate_off_to_on_local: !input ramp_rate_off_to_on_local
      input_ramp_rate_on_to_off_remote: !input ramp_rate_on_to_off_remote
      input_ramp_rate_on_to_off_local: !input ramp_rate_on_to_off_local
      input_minimum_level: !input minimum_level
      input_maximum_level: !input maximum_level
      input_default_level_local: !input default_level_local
      input_default_level_remote: !input default_level_remote
      input_state_after_power_restored: !input state_after_power_restored
      input_load_type: !input load_type
      input_switch_mode: !input switch_mode
      input_smart_bulb_mode: !input smart_bulb_mode
      input_quick_start_time: !input quick_start_time
      input_quick_start_level: !input quick_start_level
      input_leading_trailing_edge: !input leading_trailing_edge
      input_local_protection: !input local_protection
      input_remote_protection: !input remote_protection
      input_firmware_update_indicator: !input firmware_update_indicator
      input_relay_click: !input relay_click
      input_disable_clear_notifications_startup: !input disable_clear_notifications_startup
      input_configure_individual_leds: !input configure_individual_leds
      input_default_led1_color_when_on: !input default_led1_color_when_on
      input_default_led1_color_when_off: !input default_led1_color_when_off
      input_default_led1_intensity_when_on: !input default_led1_intensity_when_on
      input_default_led1_intensity_when_off: !input default_led1_intensity_when_off
      input_led_bar_scaling: !input led_bar_scaling
      input_output_mode: !input output_mode
      input_invert_switch: !input invert_switch
      input_auto_timer_off: !input auto_timer_off
      input_binding_off_to_on_sync_level: !input binding_off_to_on_sync_level
      input_aux_switch_unique_scenes: !input aux_switch_unique_scenes
      input_active_power_reports: !input active_power_reports
      input_periodic_power_energy_reports: !input periodic_power_energy_reports
      input_active_energy_reports: !input active_energy_reports
      input_fan_control_mode: !input fan_control_mode
      input_low_level_for_fan_control: !input low_level_for_fan_control
      input_med_level_for_fan_control: !input med_level_for_fan_control
      input_high_level_for_fan_control: !input high_level_for_fan_control
      input_led_color_for_fan_control: !input led_color_for_fan_control

  - alias: Configure each selected device
    repeat:
      for_each: "{{ target_devices }}"
      sequence:
        - variables:
            device_name: "{{ state_attr(repeat.item, 'friendly_name') | default(repeat.item) }}"
            device_topic: "zigbee2mqtt/{{ device_name | replace(' ', '_') }}/set"

            # Get current values from entity attributes (may be 'unknown' if not exposed)
            # LED settings
            current_led_color_on: "{{ state_attr(repeat.item, 'led_color_when_on') | default('unknown') }}"
            current_led_color_off: "{{ state_attr(repeat.item, 'led_color_when_off') | default('unknown') }}"
            current_led_intensity_on: "{{ state_attr(repeat.item, 'led_intensity_when_on') | default('unknown') }}"
            current_led_intensity_off: "{{ state_attr(repeat.item, 'led_intensity_when_off') | default('unknown') }}"
            current_on_off_led_mode: "{{ state_attr(repeat.item, 'on_off_led_mode') | default('unknown') }}"

            # Button settings
            current_button_delay: "{{ state_attr(repeat.item, 'button_delay') | default('unknown') }}"
            current_single_tap_behavior: "{{ state_attr(repeat.item, 'single_tap_behavior') | default('unknown') }}"
            current_double_tap_up: "{{ state_attr(repeat.item, 'double_tap_up_to_param55') | default('unknown') }}"
            current_double_tap_down: "{{ state_attr(repeat.item, 'double_tap_down_to_param56') | default('unknown') }}"
            current_double_tap_up_level: "{{ state_attr(repeat.item, 'brightness_level_for_double_tap_up') | default('unknown') }}"
            current_double_tap_down_level: "{{ state_attr(repeat.item, 'brightness_level_for_double_tap_down') | default('unknown') }}"
            current_double_tap_clear: "{{ state_attr(repeat.item, 'double_tap_clear_notifications') | default('unknown') }}"

            # Dimming/Ramp settings
            current_dimming_speed_up_remote: "{{ state_attr(repeat.item, 'dimming_speed_up_remote') | default('unknown') }}"
            current_dimming_speed_up_local: "{{ state_attr(repeat.item, 'dimming_speed_up_local') | default('unknown') }}"
            current_dimming_speed_down_remote: "{{ state_attr(repeat.item, 'dimming_speed_down_remote') | default('unknown') }}"
            current_dimming_speed_down_local: "{{ state_attr(repeat.item, 'dimming_speed_down_local') | default('unknown') }}"
            current_ramp_rate_off_on_remote: "{{ state_attr(repeat.item, 'ramp_rate_off_to_on_remote') | default('unknown') }}"
            current_ramp_rate_off_on_local: "{{ state_attr(repeat.item, 'ramp_rate_off_to_on_local') | default('unknown') }}"
            current_ramp_rate_on_off_remote: "{{ state_attr(repeat.item, 'ramp_rate_on_to_off_remote') | default('unknown') }}"
            current_ramp_rate_on_off_local: "{{ state_attr(repeat.item, 'ramp_rate_on_to_off_local') | default('unknown') }}"

            # Level settings
            current_minimum_level: "{{ state_attr(repeat.item, 'minimum_level') | default('unknown') }}"
            current_maximum_level: "{{ state_attr(repeat.item, 'maximum_level') | default('unknown') }}"
            current_default_level_local: "{{ state_attr(repeat.item, 'default_level_local') | default('unknown') }}"
            current_default_level_remote: "{{ state_attr(repeat.item, 'default_level_remote') | default('unknown') }}"

            # Power and mode settings
            current_state_after_power: "{{ state_attr(repeat.item, 'state_after_power_restored') | default('unknown') }}"
            current_load_type: "{{ state_attr(repeat.item, 'load_type') | default('unknown') }}"
            current_switch_mode: "{{ state_attr(repeat.item, 'switch_mode') | default('unknown') }}"
            current_smart_bulb_mode: "{{ state_attr(repeat.item, 'smart_bulb_mode') | default('unknown') }}"
            current_quick_start_time: "{{ state_attr(repeat.item, 'quick_start_time') | default('unknown') }}"
            current_quick_start_level: "{{ state_attr(repeat.item, 'quick_start_level') | default('unknown') }}"
            current_leading_trailing_edge: "{{ state_attr(repeat.item, 'leading_trailing_edge') | default('unknown') }}"

            # Protection settings
            current_local_protection: "{{ state_attr(repeat.item, 'local_protection') | default('unknown') }}"
            current_remote_protection: "{{ state_attr(repeat.item, 'remote_protection') | default('unknown') }}"

            # Advanced settings
            current_firmware_update_indicator: "{{ state_attr(repeat.item, 'firmware_update_in_progress_indicator') | default('unknown') }}"
            current_relay_click: "{{ state_attr(repeat.item, 'relay_click') | default('unknown') }}"
            current_disable_clear_notifications: "{{ state_attr(repeat.item, 'disable_clear_notifications_startup') | default('unknown') }}"
            current_led_bar_scaling: "{{ state_attr(repeat.item, 'led_bar_scaling') | default('unknown') }}"
            current_output_mode: "{{ state_attr(repeat.item, 'output_mode') | default('unknown') }}"
            current_invert_switch: "{{ state_attr(repeat.item, 'invert_switch') | default('unknown') }}"
            current_auto_timer_off: "{{ state_attr(repeat.item, 'auto_timer_off') | default('unknown') }}"
            current_binding_off_on_sync: "{{ state_attr(repeat.item, 'binding_off_to_on_sync_level') | default('unknown') }}"
            current_aux_switch_scenes: "{{ state_attr(repeat.item, 'aux_switch_unique_scenes') | default('unknown') }}"

            # Power reporting
            current_active_power_reports: "{{ state_attr(repeat.item, 'active_power_reports') | default('unknown') }}"
            current_periodic_power_reports: "{{ state_attr(repeat.item, 'periodic_power_and_energy_reports') | default('unknown') }}"
            current_active_energy_reports: "{{ state_attr(repeat.item, 'active_energy_reports') | default('unknown') }}"

            # Fan control
            current_fan_control_mode: "{{ state_attr(repeat.item, 'fan_control_mode') | default('unknown') }}"
            current_low_level_fan: "{{ state_attr(repeat.item, 'low_level_for_fan_control_mode') | default('unknown') }}"
            current_med_level_fan: "{{ state_attr(repeat.item, 'med_level_for_fan_control_mode') | default('unknown') }}"
            current_high_level_fan: "{{ state_attr(repeat.item, 'high_level_for_fan_control_mode') | default('unknown') }}"
            current_led_color_fan: "{{ state_attr(repeat.item, 'led_color_for_fan_control_mode') | default('unknown') }}"

            # Individual LED settings
            current_configure_individual_leds: "{{ configure_individual_leds }}"
            current_led1_color_on: "{{ state_attr(repeat.item, 'default_led1_color_when_on') | default('unknown') }}"
            current_led1_color_off: "{{ state_attr(repeat.item, 'default_led1_color_when_off') | default('unknown') }}"
            current_led1_intensity_on: "{{ state_attr(repeat.item, 'default_led1_intensity_when_on') | default('unknown') }}"
            current_led1_intensity_off: "{{ state_attr(repeat.item, 'default_led1_intensity_when_off') | default('unknown') }}"

            # Check what's changing (comparing strings to handle different types)
            changes: >
              {% set change_list = [] %}
              {# LED Settings #}
              {% if current_led_color_on | string != led_color_when_on | string and current_led_color_on != 'unknown' %}
                {% set change_list = change_list + ['LED Color On: ' + (color_names[current_led_color_on] | default(current_led_color_on)) + ' → ' + (color_names[led_color_when_on] | default(led_color_when_on))] %}
              {% endif %}
              {% if current_led_color_off | string != led_color_when_off | string and current_led_color_off != 'unknown' %}
                {% set change_list = change_list + ['LED Color Off: ' + (color_names[current_led_color_off] | default(current_led_color_off)) + ' → ' + (color_names[led_color_when_off] | default(led_color_when_off))] %}
              {% endif %}
              {% if current_led_intensity_on | string != led_intensity_when_on | string and current_led_intensity_on != 'unknown' %}
                {% set change_list = change_list + ['LED Intensity On: ' + current_led_intensity_on | string + '% → ' + led_intensity_when_on | string + '%'] %}
              {% endif %}
              {% if current_led_intensity_off | string != led_intensity_when_off | string and current_led_intensity_off != 'unknown' %}
                {% set change_list = change_list + ['LED Intensity Off: ' + current_led_intensity_off | string + '% → ' + led_intensity_when_off | string + '%'] %}
              {% endif %}
              {% if current_on_off_led_mode != on_off_led_mode and current_on_off_led_mode != 'unknown' %}
                {% set change_list = change_list + ['LED Mode: ' + current_on_off_led_mode + ' → ' + on_off_led_mode] %}
              {% endif %}
              {# Button Settings #}
              {% if current_button_delay != button_delay and current_button_delay != 'unknown' %}
                {% set change_list = change_list + ['Button Delay: ' + current_button_delay + ' → ' + button_delay] %}
              {% endif %}
              {% if current_single_tap_behavior != single_tap_behavior and current_single_tap_behavior != 'unknown' %}
                {% set change_list = change_list + ['Single Tap: ' + current_single_tap_behavior + ' → ' + single_tap_behavior] %}
              {% endif %}
              {% if current_double_tap_up != double_tap_up_enabled and current_double_tap_up != 'unknown' %}
                {% set change_list = change_list + ['Double Tap Up: ' + current_double_tap_up + ' → ' + double_tap_up_enabled] %}
              {% endif %}
              {% if current_double_tap_down != double_tap_down_enabled and current_double_tap_down != 'unknown' %}
                {% set change_list = change_list + ['Double Tap Down: ' + current_double_tap_down + ' → ' + double_tap_down_enabled] %}
              {% endif %}
              {% if current_double_tap_up_level | string != double_tap_up_level | string and current_double_tap_up_level != 'unknown' %}
                {% set change_list = change_list + ['Double Tap Up Level: ' + current_double_tap_up_level | string + ' → ' + double_tap_up_level | string] %}
              {% endif %}
              {% if current_double_tap_down_level | string != double_tap_down_level | string and current_double_tap_down_level != 'unknown' %}
                {% set change_list = change_list + ['Double Tap Down Level: ' + current_double_tap_down_level | string + ' → ' + double_tap_down_level | string] %}
              {% endif %}
              {% if current_double_tap_clear != double_tap_clear_notifications and current_double_tap_clear != 'unknown' %}
                {% set change_list = change_list + ['Double Tap Clear: ' + current_double_tap_clear + ' → ' + double_tap_clear_notifications] %}
              {% endif %}
              {# Dimming/Ramp Settings #}
              {% if current_dimming_speed_up_remote | string != dimming_speed_up_remote | string and current_dimming_speed_up_remote != 'unknown' %}
                {% set change_list = change_list + ['Dimming Up Remote: ' + current_dimming_speed_up_remote | string + ' → ' + dimming_speed_up_remote | string] %}
              {% endif %}
              {% if current_dimming_speed_up_local | string != dimming_speed_up_local | string and current_dimming_speed_up_local != 'unknown' %}
                {% set change_list = change_list + ['Dimming Up Local: ' + current_dimming_speed_up_local | string + ' → ' + dimming_speed_up_local | string] %}
              {% endif %}
              {% if current_dimming_speed_down_remote | string != dimming_speed_down_remote | string and current_dimming_speed_down_remote != 'unknown' %}
                {% set change_list = change_list + ['Dimming Down Remote: ' + current_dimming_speed_down_remote | string + ' → ' + dimming_speed_down_remote | string] %}
              {% endif %}
              {% if current_dimming_speed_down_local | string != dimming_speed_down_local | string and current_dimming_speed_down_local != 'unknown' %}
                {% set change_list = change_list + ['Dimming Down Local: ' + current_dimming_speed_down_local | string + ' → ' + dimming_speed_down_local | string] %}
              {% endif %}
              {% if current_ramp_rate_off_on_remote | string != ramp_rate_off_to_on_remote | string and current_ramp_rate_off_on_remote != 'unknown' %}
                {% set change_list = change_list + ['Ramp Off→On Remote: ' + current_ramp_rate_off_on_remote | string + ' → ' + ramp_rate_off_to_on_remote | string] %}
              {% endif %}
              {% if current_ramp_rate_off_on_local | string != ramp_rate_off_to_on_local | string and current_ramp_rate_off_on_local != 'unknown' %}
                {% set change_list = change_list + ['Ramp Off→On Local: ' + current_ramp_rate_off_on_local | string + ' → ' + ramp_rate_off_to_on_local | string] %}
              {% endif %}
              {% if current_ramp_rate_on_off_remote | string != ramp_rate_on_to_off_remote | string and current_ramp_rate_on_off_remote != 'unknown' %}
                {% set change_list = change_list + ['Ramp On→Off Remote: ' + current_ramp_rate_on_off_remote | string + ' → ' + ramp_rate_on_to_off_remote | string] %}
              {% endif %}
              {% if current_ramp_rate_on_off_local | string != ramp_rate_on_to_off_local | string and current_ramp_rate_on_off_local != 'unknown' %}
                {% set change_list = change_list + ['Ramp On→Off Local: ' + current_ramp_rate_on_off_local | string + ' → ' + ramp_rate_on_to_off_local | string] %}
              {% endif %}
              {# Level Settings #}
              {% if current_minimum_level | string != minimum_level | string and current_minimum_level != 'unknown' %}
                {% set change_list = change_list + ['Minimum Level: ' + current_minimum_level | string + ' → ' + minimum_level | string] %}
              {% endif %}
              {% if current_maximum_level | string != maximum_level | string and current_maximum_level != 'unknown' %}
                {% set change_list = change_list + ['Maximum Level: ' + current_maximum_level | string + ' → ' + maximum_level | string] %}
              {% endif %}
              {% if current_default_level_local | string != default_level_local | string and current_default_level_local != 'unknown' %}
                {% set change_list = change_list + ['Default Level Local: ' + current_default_level_local | string + ' → ' + default_level_local | string] %}
              {% endif %}
              {% if current_default_level_remote | string != default_level_remote | string and current_default_level_remote != 'unknown' %}
                {% set change_list = change_list + ['Default Level Remote: ' + current_default_level_remote | string + ' → ' + default_level_remote | string] %}
              {% endif %}
              {# Power/Mode Settings #}
              {% if current_state_after_power | string != state_after_power_restored | string and current_state_after_power != 'unknown' %}
                {% set change_list = change_list + ['Power Restore: ' + current_state_after_power | string + ' → ' + state_after_power_restored | string] %}
              {% endif %}
              {% if current_load_type != load_type and current_load_type != 'unknown' %}
                {% set change_list = change_list + ['Load Type: ' + current_load_type + ' → ' + load_type] %}
              {% endif %}
              {% if current_switch_mode != switch_mode and current_switch_mode != 'unknown' %}
                {% set change_list = change_list + ['Switch Mode: ' + current_switch_mode + ' → ' + switch_mode] %}
              {% endif %}
              {% if current_smart_bulb_mode != smart_bulb_mode and current_smart_bulb_mode != 'unknown' %}
                {% set change_list = change_list + ['Smart Bulb Mode: ' + current_smart_bulb_mode + ' → ' + smart_bulb_mode] %}
              {% endif %}
              {% if current_quick_start_time | string != quick_start_time | string and current_quick_start_time != 'unknown' %}
                {% set change_list = change_list + ['Quick Start Time: ' + current_quick_start_time | string + ' → ' + quick_start_time | string] %}
              {% endif %}
              {% if current_quick_start_level | string != quick_start_level | string and current_quick_start_level != 'unknown' %}
                {% set change_list = change_list + ['Quick Start Level: ' + current_quick_start_level | string + ' → ' + quick_start_level | string] %}
              {% endif %}
              {% if current_leading_trailing_edge != leading_trailing_edge and current_leading_trailing_edge != 'unknown' %}
                {% set change_list = change_list + ['Leading/Trailing: ' + current_leading_trailing_edge + ' → ' + leading_trailing_edge] %}
              {% endif %}
              {# Protection Settings #}
              {% if current_local_protection != local_protection and current_local_protection != 'unknown' %}
                {% set change_list = change_list + ['Local Protection: ' + current_local_protection + ' → ' + local_protection] %}
              {% endif %}
              {% if current_remote_protection != remote_protection and current_remote_protection != 'unknown' %}
                {% set change_list = change_list + ['Remote Protection: ' + current_remote_protection + ' → ' + remote_protection] %}
              {% endif %}
              {# Advanced Settings #}
              {% if current_firmware_update_indicator != firmware_update_indicator and current_firmware_update_indicator != 'unknown' %}
                {% set change_list = change_list + ['FW Update Indicator: ' + current_firmware_update_indicator + ' → ' + firmware_update_indicator] %}
              {% endif %}
              {% if current_relay_click != relay_click and current_relay_click != 'unknown' %}
                {% set change_list = change_list + ['Relay Click: ' + current_relay_click + ' → ' + relay_click] %}
              {% endif %}
              {% if current_disable_clear_notifications != disable_clear_notifications_startup and current_disable_clear_notifications != 'unknown' %}
                {% set change_list = change_list + ['Disable Clear Notif: ' + current_disable_clear_notifications + ' → ' + disable_clear_notifications_startup] %}
              {% endif %}
              {% if current_led_bar_scaling != led_bar_scaling and current_led_bar_scaling != 'unknown' %}
                {% set change_list = change_list + ['LED Bar Scaling: ' + current_led_bar_scaling + ' → ' + led_bar_scaling] %}
              {% endif %}
              {% if current_output_mode != output_mode and current_output_mode != 'unknown' %}
                {% set change_list = change_list + ['Output Mode: ' + current_output_mode + ' → ' + output_mode] %}
              {% endif %}
              {% if current_invert_switch != invert_switch and current_invert_switch != 'unknown' %}
                {% set change_list = change_list + ['Invert Switch: ' + current_invert_switch + ' → ' + invert_switch] %}
              {% endif %}
              {% if current_auto_timer_off | string != auto_timer_off | string and current_auto_timer_off != 'unknown' %}
                {% set change_list = change_list + ['Auto Timer Off: ' + current_auto_timer_off | string + ' → ' + auto_timer_off | string] %}
              {% endif %}
              {% if current_binding_off_on_sync != binding_off_to_on_sync_level and current_binding_off_on_sync != 'unknown' %}
                {% set change_list = change_list + ['Binding Sync: ' + current_binding_off_on_sync + ' → ' + binding_off_to_on_sync_level] %}
              {% endif %}
              {% if current_aux_switch_scenes != aux_switch_unique_scenes and current_aux_switch_scenes != 'unknown' %}
                {% set change_list = change_list + ['Aux Switch Scenes: ' + current_aux_switch_scenes + ' → ' + aux_switch_unique_scenes] %}
              {% endif %}
              {# Power Reporting #}
              {% if current_active_power_reports | string != active_power_reports | string and current_active_power_reports != 'unknown' %}
                {% set change_list = change_list + ['Active Power Reports: ' + current_active_power_reports | string + ' → ' + active_power_reports | string] %}
              {% endif %}
              {% if current_periodic_power_reports | string != periodic_power_energy_reports | string and current_periodic_power_reports != 'unknown' %}
                {% set change_list = change_list + ['Periodic Reports: ' + current_periodic_power_reports | string + ' → ' + periodic_power_energy_reports | string] %}
              {% endif %}
              {% if current_active_energy_reports | string != active_energy_reports | string and current_active_energy_reports != 'unknown' %}
                {% set change_list = change_list + ['Active Energy Reports: ' + current_active_energy_reports | string + ' → ' + active_energy_reports | string] %}
              {% endif %}
              {# Fan Control #}
              {% if current_fan_control_mode != fan_control_mode and current_fan_control_mode != 'unknown' %}
                {% set change_list = change_list + ['Fan Control Mode: ' + current_fan_control_mode + ' → ' + fan_control_mode] %}
              {% endif %}
              {% if current_low_level_fan | string != low_level_for_fan_control | string and current_low_level_fan != 'unknown' %}
                {% set change_list = change_list + ['Fan Low Level: ' + current_low_level_fan | string + ' → ' + low_level_for_fan_control | string] %}
              {% endif %}
              {% if current_med_level_fan | string != med_level_for_fan_control | string and current_med_level_fan != 'unknown' %}
                {% set change_list = change_list + ['Fan Med Level: ' + current_med_level_fan | string + ' → ' + med_level_for_fan_control | string] %}
              {% endif %}
              {% if current_high_level_fan | string != high_level_for_fan_control | string and current_high_level_fan != 'unknown' %}
                {% set change_list = change_list + ['Fan High Level: ' + current_high_level_fan | string + ' → ' + high_level_for_fan_control | string] %}
              {% endif %}
              {% if current_led_color_fan | string != led_color_for_fan_control | string and current_led_color_fan != 'unknown' %}
                {% set change_list = change_list + ['Fan LED Color: ' + (color_names[current_led_color_fan] | default(current_led_color_fan)) + ' → ' + (color_names[led_color_for_fan_control] | default(led_color_for_fan_control))] %}
              {% endif %}
              {# Individual LEDs #}
              {% if configure_individual_leds %}
                {% if current_led1_color_on | string != default_led1_color_when_on | string and current_led1_color_on != 'unknown' %}
                  {% set change_list = change_list + ['LED1 Color On: ' + current_led1_color_on | string + ' → ' + default_led1_color_when_on | string] %}
                {% endif %}
                {% if current_led1_color_off | string != default_led1_color_when_off | string and current_led1_color_off != 'unknown' %}
                  {% set change_list = change_list + ['LED1 Color Off: ' + current_led1_color_off | string + ' → ' + default_led1_color_when_off | string] %}
                {% endif %}
                {% if current_led1_intensity_on | string != default_led1_intensity_when_on | string and current_led1_intensity_on != 'unknown' %}
                  {% set change_list = change_list + ['LED1 Intensity On: ' + current_led1_intensity_on | string + ' → ' + default_led1_intensity_when_on | string] %}
                {% endif %}
                {% if current_led1_intensity_off | string != default_led1_intensity_when_off | string and current_led1_intensity_off != 'unknown' %}
                  {% set change_list = change_list + ['LED1 Intensity Off: ' + current_led1_intensity_off | string + ' → ' + default_led1_intensity_when_off | string] %}
                {% endif %}
              {% endif %}
              {{ change_list }}

            change_count: "{{ changes | length }}"

        # Show preview notification
        - if:
            - condition: template
              value_template: "{{ preview_mode }}"
          then:
            - service: persistent_notification.create
              data:
                title: "🔍 VZM31-SN Preview: {{ device_name }}"
                message: |
                  {% if change_count | int > 0 %}
                  **📝 {{ change_count }} changes would be applied:**

                  {% for change in changes %}
                  • {{ change }}
                  {% endfor %}
                  {% else %}
                  ✅ **No changes needed** - device already has these settings
                  {% endif %}

                  {% if show_unchanged %}

                  **Current Settings (unchanged):**
                  {% if current_led_color_on | string == led_color_when_on | string and current_led_color_on != 'unknown' %}
                  • LED Color On: {{ color_names[current_led_color_on] | default(current_led_color_on) }}
                  {% endif %}
                  {% if current_led_color_off | string == led_color_when_off | string and current_led_color_off != 'unknown' %}
                  • LED Color Off: {{ color_names[current_led_color_off] | default(current_led_color_off) }}
                  {% endif %}
                  {% if current_led_intensity_on | string == led_intensity_when_on | string and current_led_intensity_on != 'unknown' %}
                  • LED Intensity On: {{ current_led_intensity_on }}%
                  {% endif %}
                  {% if current_led_intensity_off | string == led_intensity_when_off | string and current_led_intensity_off != 'unknown' %}
                  • LED Intensity Off: {{ current_led_intensity_off }}%
                  {% endif %}
                  {% endif %}

                  ---
                  *Preview Mode - No changes applied*
                notification_id: "vzm31_preview_{{ repeat.item | replace('.', '_') }}"

        # Apply changes if not in preview mode
        - if:
            - condition: template
              value_template: "{{ not preview_mode }}"
          then:
            - alias: Set LED color when on
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  ledColorWhenOn: !input led_color_when_on

            - alias: Set LED color when off
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  ledColorWhenOff: !input led_color_when_off

            - alias: Set LED intensity when on
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  ledIntensityWhenOn: !input led_intensity_when_on

            - alias: Set LED intensity when off
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  ledIntensityWhenOff: !input led_intensity_when_off

            - alias: Set LED mode
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  onOffLedMode: !input on_off_led_mode

            - alias: Set button delay
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  buttonDelay: !input button_delay

            - alias: Set single tap behavior
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  singleTapBehavior: !input single_tap_behavior

            - alias: Set double tap up
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  doubleTapUpToParam55: !input double_tap_up_enabled

            - alias: Set double tap down
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  doubleTapDownToParam56: !input double_tap_down_enabled

            - alias: Set double tap up level
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  brightnessLevelForDoubleTapUp: !input double_tap_up_level

            - alias: Set double tap down level
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  brightnessLevelForDoubleTapDown: !input double_tap_down_level

            - alias: Set double tap clear notifications
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  doubleTapClearNotifications: !input double_tap_clear_notifications

            - alias: Set dimming speeds
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  dimmingSpeedUpRemote: !input dimming_speed_up_remote
                  dimmingSpeedUpLocal: !input dimming_speed_up_local
                  dimmingSpeedDownRemote: !input dimming_speed_down_remote
                  dimmingSpeedDownLocal: !input dimming_speed_down_local

            - alias: Set ramp rates
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  rampRateOffToOnRemote: !input ramp_rate_off_to_on_remote
                  rampRateOffToOnLocal: !input ramp_rate_off_to_on_local
                  rampRateOnToOffRemote: !input ramp_rate_on_to_off_remote
                  rampRateOnToOffLocal: !input ramp_rate_on_to_off_local

            - alias: Set min/max levels
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  minimumLevel: !input minimum_level
                  maximumLevel: !input maximum_level

            - alias: Set default levels
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  defaultLevelLocal: !input default_level_local
                  defaultLevelRemote: !input default_level_remote

            - alias: Set state after power restored
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  stateAfterPowerRestored: !input state_after_power_restored

            - alias: Set load type
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  loadType: !input load_type

            - alias: Set switch mode
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  switchMode: !input switch_mode

            - alias: Set smart bulb mode
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  smartBulbMode: !input smart_bulb_mode

            - alias: Set quick start settings
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  quickStartTime: !input quick_start_time
                  quickStartLevel: !input quick_start_level

            - alias: Set leading/trailing edge
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  leadingTrailingEdge: !input leading_trailing_edge

            - alias: Set protection settings
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  localProtection: !input local_protection
                  remoteProtection: !input remote_protection

            - alias: Set firmware update indicator
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  firmwareUpdateInProgressIndicator: !input firmware_update_indicator

            - alias: Set relay click
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  relayClick: !input relay_click

            - alias: Set disable clear notifications on startup
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  disableClearNotificationsStartup: !input disable_clear_notifications_startup

            - alias: Configure individual LED 1 if enabled
              if:
                - condition: template
                  value_template: "{{ configure_individual_leds }}"
              then:
                - alias: Set LED 1 configuration
                  service: mqtt.publish
                  data:
                    topic: "{{ device_topic }}"
                    payload_json:
                      defaultLed1ColorWhenOn: !input default_led1_color_when_on
                      defaultLed1ColorWhenOff: !input default_led1_color_when_off
                      defaultLed1IntensityWhenOn: !input default_led1_intensity_when_on
                      defaultLed1IntensityWhenOff: !input default_led1_intensity_when_off

            - alias: Set LED bar scaling
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  ledBarScaling: !input led_bar_scaling

            - alias: Set output mode
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  outputMode: !input output_mode

            - alias: Set invert switch
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  invertSwitch: !input invert_switch

            - alias: Set auto timer off
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  autoTimerOff: !input auto_timer_off

            - alias: Set binding off to on sync level
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  bindingOffToOnSyncLevel: !input binding_off_to_on_sync_level

            - alias: Set aux switch unique scenes
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  auxSwitchUniqueScenes: !input aux_switch_unique_scenes

            - alias: Set power reporting
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  activePowerReports: !input active_power_reports
                  periodicPowerAndEnergyReports: !input periodic_power_energy_reports
                  activeEnergyReports: !input active_energy_reports

            - alias: Set fan control settings
              service: mqtt.publish
              data:
                topic: "{{ device_topic }}"
                payload_json:
                  fanControlMode: !input fan_control_mode
                  lowLevelForFanControlMode: !input low_level_for_fan_control
                  medLevelForFanControlMode: !input med_level_for_fan_control
                  highLevelForFanControlMode: !input high_level_for_fan_control
                  ledColorForFanControlMode: !input led_color_for_fan_control

            - delay:
                milliseconds: 100

  # Show final summary if in preview mode
  - if:
      - condition: template
        value_template: "{{ preview_mode }}"
    then:
      - service: persistent_notification.create
        data:
          title: "📊 VZM31-SN Preview Summary"
          message: |
            **Preview Complete!**

            Reviewed {{ target_devices | length }} device(s) for configuration changes.

            To apply these changes:
            1. Review the individual device notifications above
            2. Turn off "Preview Mode" in the script settings
            3. Run the script again

            The configuration will then be applied to all selected devices.
          notification_id: "vzm31_preview_summary"

mode: parallel
max: 10
icon: mdi:light-switch